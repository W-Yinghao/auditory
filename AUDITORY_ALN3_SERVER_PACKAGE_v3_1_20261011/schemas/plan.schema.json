{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "family_id",
    "dataset",
    "job_kind",
    "base_commit",
    "seed",
    "subject_fold",
    "content_fold",
    "spec",
    "logical_dependencies",
    "status",
    "seed_scope"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^ALN3_[A-Fa-f0-9]{16}$"
    },
    "family_id": {
      "type": "string"
    },
    "dataset": {
      "enum": [
        "fau",
        "dtu",
        "federici",
        "private_bdf"
      ]
    },
    "job_kind": {
      "enum": [
        "train",
        "staged_train",
        "probe_fit",
        "support_adapt",
        "reaggregate",
        "reevaluate",
        "analysis"
      ]
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "seed": {
      "type": "integer"
    },
    "subject_fold": {
      "type": [
        "integer",
        "null"
      ]
    },
    "content_fold": {
      "type": [
        "integer",
        "null"
      ]
    },
    "spec": {
      "type": "object"
    },
    "logical_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "const": "planned_needs_binding"
    },
    "seed_scope": {
      "enum": [
        "breadth",
        "panel"
      ]
    }
  }
}
