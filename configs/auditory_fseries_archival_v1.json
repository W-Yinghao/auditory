{
  "version": "auditory_fseries_archival_v1",
  "estimand": "candidate_identity_heldout_prediction_of_literal_HA_archive_scores",
  "not_claimed": ["confirmed_concurrent_function", "confirmed_IT_MAIS_only", "future_rehabilitation", "all_CI_generalization", "causal_or_cortical_information"],
  "source_document": "AUDITORY_FUNCTIONAL_DECODING_F1_F4_RESEARCH_PLAN_v1.md",
  "qualification_round_preserved": true,
  "automatic_push": false,
  "population": {
    "scope": "HA_BDF_only",
