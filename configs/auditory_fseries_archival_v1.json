  "screen": {
    "primary": "C_BEST_MAE_minus_C_Z_MAE",
    "quality_adjusted": "C_Q_MAE_minus_C_Q_Z_MAE",
    "content_control": "C_SHUFFLED_Z_MAE_minus_C_Z_MAE",
    "advance": "positive_primary_and_quality_adjusted_95pct_lower_bounds_and_positive_content_control_point_gain",
