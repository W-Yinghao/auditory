  "claims": [
    {
      "id": "C01",
      "topic": "sound_content",
      "sources": [
        "E02"
      ],
      "claim": "CB pretrained true-full representations exceed matched-access local for history-conditional envelope readout on DTU and FAU; a DTU spectral-residual contrast is also positive.",
      "evidence": [
        {
          "label": "DTU CBpre minus local envelope-history r",
          "estimate": 0.008995,
          "simultaneous_95_ci": [
            0.000566,
            0.017424
          ],
          "unit": "Pearson_r",
          "n_people": 44
        },
        {
          "label": "FAU CBpre minus local envelope-history r",
          "estimate": 0.011993,
          "simultaneous_95_ci": [
            0.004213,
            0.019772
          ],
          "unit": "Pearson_r",
          "n_people": 67
        },
        {
          "label": "DTU CBpre minus local spectral residual r",
          "estimate": 0.003998,
          "simultaneous_95_ci": [
            5.8e-05,
            0.007938
          ],
          "unit": "Pearson_r",
          "n_people": 44
        }
      ],
      "scope": "Exploratory named paired families; same-person complete content/seed aggregation; source-trained feature residuals.",
      "does_not_establish": [
        "Universal content improvement",
        "A neural mechanism of the new CS method",
        "Cross-paradigm transfer by itself"
      ]
    },
